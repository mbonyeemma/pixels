# Pixels server configuration. Copy to `.env` (git-ignored) and fill in what you need.
# Real environment variables always override values in this file.
# All values below are placeholders: never commit real keys.

# --- Server ---------------------------------------------------------------
# HTTP + WebSocket port
PORT=8787
# Where the JSON database (db.json) is stored. Relative paths resolve from the process working directory.
DATA_DIR=./data
# Built web app to serve (SPA fallback). Defaults to ../web/dist relative to apps/server if that folder exists.
# STATIC_DIR=../web/dist
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For (used for per-IP rate limits).
# TRUST_PROXY=0
# debug | info | warn | error | silent
# LOG_LEVEL=info

# --- AI assistant ---------------------------------------------------------
# auto      = Anthropic when ANTHROPIC_API_KEY is set, otherwise the offline rules assistant
# anthropic = require Anthropic
# rules     = always use the offline rules assistant (no network, no key)
AI_PROVIDER=auto
# Leave empty to run the offline rules assistant.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Per-request timeout for the model call, in milliseconds
AI_TIMEOUT_MS=15000
# Requests per player per day
AI_DAILY_LIMIT=100
# Requests per player per minute
AI_RATE_PER_MIN=10
# Optional: override the Anthropic API base URL (proxies / tests)
# AI_BASE_URL=

# --- Payments (FUTURE PHASE, not implemented yet) -------------------------
# The shop currently uses mock in-game coins only (no real value). A Solana provider will plug into the
# PaymentProvider interface in apps/server/src/shop.ts. Devnet ONLY; never put a mainnet key here.
# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_TREASURY_PUBLIC_KEY=<devnet public key placeholder>
# SOLANA_CONFIRMATION_TIMEOUT_MS=30000
