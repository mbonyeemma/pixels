# Pixels server configuration. Copy to `.env` (git-ignored) and fill in what you need.
# Real environment variables always override values in this file.
# All values below are placeholders: never commit real keys.

# --- Server ---------------------------------------------------------------
# HTTP + WebSocket port
PORT=8787
# Where the JSON database (db.json) is stored. Relative paths resolve from the process working directory.
DATA_DIR=./data
# Built web app to serve (SPA fallback). Defaults to ../web/dist relative to apps/server if that folder exists.
# STATIC_DIR=../web/dist
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For (used for per-IP rate limits).
# TRUST_PROXY=0
# debug | info | warn | error | silent
# LOG_LEVEL=info

# --- AI assistant ---------------------------------------------------------
# auto      = Anthropic when ANTHROPIC_API_KEY is set, otherwise the offline rules assistant
# anthropic = require Anthropic
# rules     = always use the offline rules assistant (no network, no key)
AI_PROVIDER=auto
# Leave empty to run the offline rules assistant.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Per-request timeout for the model call, in milliseconds
AI_TIMEOUT_MS=15000
# Requests per player per day
AI_DAILY_LIMIT=100
# Requests per player per minute
AI_RATE_PER_MIN=10
# Optional: override the Anthropic API base URL (proxies / tests)
# AI_BASE_URL=

# --- Optional: Solana DEVNET payments (TEST NETWORK ONLY: nothing here has real value) ---------------------
# Off by default. The game is fully playable without any wallet. When off, the wallet/pay endpoints answer 404 and the
# web app loads no wallet code at all. See docs/PAYMENTS.md for the architecture, security model and how to test.
# This server NEVER holds a private key or seed phrase: only the treasury PUBLIC key goes here (placeholders below).
PAYMENTS_ENABLED=false
# Devnet only: any other value makes the server refuse to start.
SOLANA_CLUSTER=devnet
# JSON-RPC endpoint (must be https and must not look like mainnet/testnet; the server also checks the genesis hash).
# Default: the public Devnet node. Another Devnet provider URL is fine, e.g. one with an API key (kept out of logs).
# SOLANA_RPC_URL=https://api.devnet.solana.com
# PUBLIC key of the wallet that receives payments (base58). Generate a keypair with `solana-keygen new` ONLY on your own
# machine, keep the secret file there, and paste just the public key (`solana-keygen pubkey`). Required when enabled.
# SOLANA_TREASURY_PUBKEY=<devnet treasury PUBLIC key placeholder>
# How long one /api/pay/confirm request waits for a just-sent transaction to appear on the node (ms, 1000-120000).
# SOLANA_CONFIRMATION_TIMEOUT_MS=20000
# Reserved for a future SPL-token price. Token pricing is NOT implemented: setting this only logs a warning.
# SOLANA_TOKEN_MINT=

# Web app (build time, optional): browser-side Devnet RPC used to fetch a blockhash. Must contain "devnet"; anything else
# is ignored. Default https://api.devnet.solana.com
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
